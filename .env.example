# Community forum (DiscourseConnect). Server-only: never prefix these with NEXT_PUBLIC_.
# Patient-web API to sign patients in against. gimli has the shared Playwright test patient.
QUICKMD_API_URL=https://patient-web-api.gimli.quickmd.dev/
# The Discourse site that scripts/discourse-local.sh runs.
DISCOURSE_URL=http://localhost:4200
# Must match Discourse's discourse_connect_secret. scripts/discourse-local.sh setup generates it.
DISCOURSE_CONNECT_SECRET=
# Optional: DevTools' "Sign in as test patient". The shared gimli Playwright patient
# lives in ~/quickmd/patient-web/tests/.env.test.example.
DEMO_PATIENT_EMAIL=
DEMO_PATIENT_PASSWORD=
# Discourse admin API key (Api-Username system), so signing out here also ends the forum
# session. scripts/discourse-local.sh setup writes it into .env.local.
DISCOURSE_API_KEY=
