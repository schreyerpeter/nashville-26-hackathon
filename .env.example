# Community forum (DiscourseConnect). Server-only: never prefix these with NEXT_PUBLIC_.
# Patient-web API to sign patients in against, e.g. https://patient-web-api.gimli.quickmd.dev/
QUICKMD_API_URL=
# The Discourse site, e.g. https://community.dev-common.quickmd.dev
DISCOURSE_URL=
# Must match Discourse's discourse_connect_secret setting.
DISCOURSE_CONNECT_SECRET=
# Optional: DevTools' "Sign in as test patient". The shared gimli Playwright patient
# lives in ~/quickmd/patient-web/tests/.env.test.example.
DEMO_PATIENT_EMAIL=
DEMO_PATIENT_PASSWORD=
# Discourse admin API key (Api-Username system), so signing out here also ends the forum session.
DISCOURSE_API_KEY=
